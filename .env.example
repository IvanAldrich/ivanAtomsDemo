DATABASE_URL="file:../db/custom.db"
# LLM provider（OpenAI 兼容网关）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 应用独立域名：发布应用使用 {slug}.{APP_BASE_DOMAIN}
# 生产示例：apps.example.com（需要泛解析 DNS + 泛域名证书）
# 本地示例：apps.localhost（仅浏览器与平台同机时可用）
APP_BASE_DOMAIN=

# 会话签名密钥（openssl rand -base64 32 生成）
SESSION_SECRET=

# HTTPS 生产环境设为 true（会话 Cookie 加 Secure + __Host- 前缀）
COOKIE_SECURE=

# 运行时隔离：container（Docker，生产/演示推荐）| process（仅本地开发显式降级）
# container 需要 docker daemon 与当前用户的 docker 组权限
RUNTIME_ISOLATION=container
SANDBOX_IMAGE=node:22-bookworm
SANDBOX_RUNTIME_NETWORK=atoms-runtime
SANDBOX_BUILD_NETWORK=atoms-build
# 两个网络的容器互访由 DOCKER-USER 规则阻断；docker-setup.sh 同时阻断容器→宿主
SANDBOX_MEMORY_MB=2048
SANDBOX_PIDS_LIMIT=512
SANDBOX_CPUS=2

# 构建通过后的需求验收自检（on/off，默认 on；off 可节省 token）
LLM_REVIEW=on

# 输出预算与思考开关
LLM_MAX_OUTPUT_TOKENS=32768
LLM_FILE_OUTPUT_TOKENS=24576
# on 时启用推理模型思考（默认 off，避免思考吃满输出预算导致截断）
LLM_ENABLE_THINKING=off
