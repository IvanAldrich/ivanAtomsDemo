{
  "name": "ivan-atoms-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "docker:setup": "bash scripts/docker-setup.sh",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/build/__tests__/*.test.js",
    "test:integration": "bash scripts/test-integration.sh",
    "test:sandbox": "tsx scripts/sandbox-contract.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "stats": "node scripts/build-stats.mjs",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "dotenv": "^16.6.1",
    "http-proxy": "^1.18.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.545.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.4",
    "next-intl": "^4.4.0",
    "openai": "^4.104.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.14"
  }
}
